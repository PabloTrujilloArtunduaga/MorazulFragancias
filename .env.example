# Copiar a .env en cada pieza y completar. Nunca subir el .env a Git.

# API
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Base de datos (PostgreSQL 16; en esta máquina corre en el puerto 5433)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=morazul
DB_USER=
DB_PASSWORD=
DB_SSL=false


# Almacenamiento persistente de imágenes con Vercel Blob
# Dejar vacío en desarrollo si no se utiliza Blob.
# En producción debe configurarse el token real en el entorno del servidor.
BLOB_READ_WRITE_TOKEN=

# Panel de administración y landing (Vite)
VITE_API_URL=http://localhost:3000

# Enlaces cruzados entre el panel y la landing (cada una se despliega por separado)
VITE_ADMIN_URL=http://localhost:5173
VITE_LANDING_URL=http://localhost:5174

# Imágenes servidas por la API (dirección pública base; cambia al definir el almacenamiento)
IMAGENES_BASE_URL=http://localhost:3000/uploads

# Datos de contacto de la landing (horario y dirección por definir)
CONTACTO_WHATSAPP=573233278897
CONTACTO_CORREO=MorazulFragancias@gmail.com
CONTACTO_CIUDAD=Neiva, Huila
CONTACTO_HORARIO=
CONTACTO_DIRECCION=